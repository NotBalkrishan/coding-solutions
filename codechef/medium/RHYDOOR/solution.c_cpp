
#include <stdio.h>

int main() {
    int t, n;
    scanf("%d", &t);

    while (t--) {
        scanf("%d", &n);

        char a[n + 1];
        scanf("%s", a);

        int count = 0;
        int i = 0;

        while (i < n) {
            if (i + 2 < n &&
                a[i] == a[i + 1] &&
                a[i + 1] == a[i + 2]) {
                count++;
                i += 3;
            } else {
                i++;
            }
        }

        printf("%d\n", count);
    }

    return 0;
}
