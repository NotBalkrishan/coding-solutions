#include <stdio.h>
#include<math.h>
int main() {
	// your code goes here
    int t,n;
    scanf("%d",&t);
    while(t--)
    {
        scanf("%d",&n);
        int a[n],i;
        for(i=0;i<n;i++)
        {
            scanf("%d",&a[i]);
        }
        int max=0;
        for(int i=0;i<=n-1;i++)
        {
            int x=abs(a[i]-a[i+1]);
            if(x>max)
            {
                max=x;
            }
            else
            max=max;
        }
        printf("%d\n",max);
    }
}

