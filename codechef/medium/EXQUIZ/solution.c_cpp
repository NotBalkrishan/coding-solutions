
#include <stdio.h>

int main()
{
    int t, n, s;
    scanf("%d", &t);

    while (t--)
    {
        scanf("%d%d", &n, &s);

        if (s < 0 || s > 4 * n)
            printf("-1\n");
        else if (s % 4 == 0)
            printf("%d\n", s / 4);
        else
            printf("%d\n", (s+3) / 4 + 1);
    }

    return 0;
}
