#include <stdio.h>

int main() {
    // your code goes here
    int n, x, y, z, p = 0;
    scanf("%d", & n);
    int cumsum1 = 0, cumsum2 = 0, maxlead = 0;
    while (n--)
    {
        scanf("%d%d", & x, & y);
        cumsum1 = cumsum1 + x;
        cumsum2 = cumsum2 + y;
        if (cumsum1 > cumsum2)
        {
            z = cumsum1 - cumsum2;

        }
        else
        {
            z = cumsum2 - cumsum1;

        }
        if (z > maxlead)
        {
            maxlead = z;

            if (cumsum1 > cumsum2)
                p = 1;
            else
                p = 2;
        }
    }


    printf("%d %d", p, maxlead);

}