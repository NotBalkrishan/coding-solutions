#include <stdio.h>

int main() {
	// your code goes here
	int t;
	float a,b,x,y;
	scanf("%d",&t);
	while(t--)
	{
	    scanf("%f%f%f%f",&a,&x,&b,&y);
	    float p=a/x;
	    float q=b/y;
	    if(p>q)
	    printf("Alice\n");
	    else if(q>p)
	    printf("Bob\n");
	    else
	    printf("Equal\n");
	}

}

