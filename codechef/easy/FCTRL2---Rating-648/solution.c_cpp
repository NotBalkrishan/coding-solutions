#include <stdio.h>

int main()
{
    int t, n;
    scanf("%d", &t);

    while (t--)
    {
        scanf("%d", &n);

        int fact[200];
        int size = 1;

        fact[0] = 1;

        for (int i = 2; i <= n; i++)
        {
            int carry = 0;

            for (int j = 0; j < size; j++)
            {
                int x = fact[j] * i + carry;

                fact[j] = x % 10;
                carry = x / 10;
            }

            while (carry > 0)
            {
                fact[size] = carry % 10;
                carry = carry / 10;
                size++;
            }
        }

        // Print from most significant digit
        for (int i = size - 1; i >= 0; i--)
        {
            printf("%d", fact[i]);
        }

        printf("\n");
    }

    return 0;
}