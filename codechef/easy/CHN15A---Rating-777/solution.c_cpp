#include <stdio.h>

int main() {
	// your code goes here
	int t,n,k,x;
	scanf("%d",&t);
	while(t--)
	{
	    int count=0;
	    scanf("%d%d",&n,&k);
	    for(int i=1;i<=n;i++)
	    {
	        scanf("%d",&x);
	        if((k+x)%7==0)
	        {
	            count++;
	        }
	        
	    }
	    printf("%d\n",count);
	}

}

