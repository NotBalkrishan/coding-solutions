#include <stdio.h>

int main() {
	// your code goes here
	int t,x,y,z;
	scanf("%d",&t);
	for(int i=1;i<=t;i++)
	{
	    scanf("%d%d%d",&x,&y,&z);
	    int n=x/3;
	    if(x>=3)
	    {
	        if(x%3==0)
	        {
	            
	            printf("%d\n", (x*y)+(n*z)-z);
	            
	        }
	        else if(x%3==1)
	        printf("%d\n",(x*y)+(n*z));
	        
	        else if(x%3==2)
	        printf("%d\n",(x*y)+(n*z));
	    }
	    
	    else
	    printf("%d\n",(x*y));
	}

}

