#include <stdio.h>

int main()
{
    // your code goes here
    int t, n;
    scanf("%d", & t);
    
    while (t--)
    {
        scanf("%d", & n);
        int count1 = 0, count2 = 0;
        char a[20];
        for (int i = 0; i < n; i++)
        {
            scanf("%s", & a);
            if(strcmp(a,"START38"))
            count2++;
            if(strcmp(a,"LTIME108"))
            count1++;
        }
        printf("%d %d \n",count1,count2);

    }

}