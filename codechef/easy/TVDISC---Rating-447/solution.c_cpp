#include <stdio.h>
int main()
{
    int t,a,b,c,d;
    scanf("%d",&t);
    while(t>0)
    {
        scanf("%d %d %d %d",&a,&b,&c,&d);
        int q=a-c;
        int w=b-d;
        if(q<w)
        printf("First\n");
        else if(q==w)
        printf("Any\n");
        else
        printf("Second\n");
        t--;
    }
    return 0;
}
