#include <stdio.h>

int main()
{
    int t, n, i, j;
    unsigned long long fact;

    scanf("%d", &t);

    for (i = 0; i < t; i++)
    {
        scanf("%d", &n);

        fact = 1;

        for (j = 1; j <= n; j++)
        {
            fact = fact * j;
        }

        printf("%llu\n", fact);
    }

    return 0;
}