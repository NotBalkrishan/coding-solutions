#include <stdio.h>

int main() {
    // your code goes here
    int t, n;
    scanf("%d", & t);
    while (t--)
    {
    int flag = 1;
        scanf("%d", & n);
        if(n<2)
        flag=0;
        else
        {
            for (int i = 2; i < n; i++)
            {
                if (n % i == 0)
                {
                    flag =  0;
                    break;
                }
                else
                    flag = 1;
            }
        }
        if (flag == 1)
            printf("yes\n");
        else
            printf("no\n");
    }

}