#include <stdio.h>

int main() {
	// your code goes here
	int t,s,x,y,z;
	scanf("%d",&t);
	while(t--)
	{
	    scanf("%d%d%d%d",&s,&x,&y,&z);
	    s=s-x-y;
	    if(s>=z)
	    printf("0\n");
	    else
	    {
	        if(((s+x)>=z) || ((s+y)>=z))
	        printf("1\n");
	        else
	        printf("2\n");
	    }
	}

}

