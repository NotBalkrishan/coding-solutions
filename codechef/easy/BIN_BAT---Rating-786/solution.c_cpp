#include <stdio.h>

int main() {
	// your code goes here
	int t,n,a,b;
	scanf("%d",&t);
	while(t--)
	{
	    scanf("%d%d%d",&n,&a,&b);
	    int count=0;
	    while(n>1)
	    {
	        count++;
	        n=n/2;
	    }
	    int time=count;
	    int break1=count-1;
	    printf("%d\n",(time*a)+(b*break1));
	}

}