
#include <stdio.h>

int main() {
    int t, n;
    scanf("%d", &t);

    while (t--) {
        scanf("%d", &n);

        int a[n];

        for (int i = 0; i < n; i++) {
            scanf("%d", &a[i]);
        }

        int sum = 0, flag = 0;

        for (int i = 0; i < n; i++) {
            sum += a[i];

            if (sum % 2 != 0) {
                flag = 1;
                break;
            }
        }

        if (flag == 1)
            printf("Yes\n");
        else
            printf("No\n");
    }

    return 0;
}
