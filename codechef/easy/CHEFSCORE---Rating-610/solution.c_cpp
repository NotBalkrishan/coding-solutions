#include <stdio.h>

int main() {
	// your code goes here
	int t,n,x,y;
	scanf("%d",&t);
	while(t--)
	{
	    scanf("%d%d%d",&n,&x,&y);
	    if(y>=0)
	    {
	        if(y%x==0)
	    printf("Yes\n");
	    else
	    printf("No\n");
	    }
	    else
	    continue;
	    
	    if(y>(x*n))
	    printf("no\n");
	    
	    else
	    continue;
	    
	    
	    
	}

}

