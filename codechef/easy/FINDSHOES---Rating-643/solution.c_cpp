#include <stdio.h>

int main() {
        // your code goes here
        int t, x, y;
        scanf("%d", & t);
        while (t--)
        {
            scanf("%d%d", & x, & y);
            if (x > y)
            {
                if (x < (2 * y))
                    printf("0\n");
                else 
                printf("%d\n", x/(2*y));

            }
            else
            printf("0\n");
        }
}