#include <stdio.h>

int main() {
	// your code goes here
	int n,x,y;
	scanf("%d",&n);
	while(n--)
	{
	    scanf("%d%d",&x,&y);
	    int a1=x*2;
	    int a2=(x+y)*2;
	    int a3=y*4;
	    int a4=(x+y)*4;
	    if((a1+a4)>(a2+a3))
	    printf("%d\n", 1500-a2-a3);
	    else
	    printf("%d\n",1500-a1-a4);
	    
	}

}

