#include <stdio.h>

int main() {
    int t, n;

    scanf("%d", &t);

    while (t--) {
        scanf("%d", &n);

        int a[n];

        for (int i = 0; i < n; i++) {
            scanf("%d", &a[i]);
        }

        for (int i = n - 1; i >= 0; i--) {
            if (a[i] != 0) {
                printf("%d\n", i);
                break;
            }
        }
    }

    return 0;
}