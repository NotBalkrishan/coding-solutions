#include <stdio.h>

int main() {
	// your code goes here
	int t,n,x;
	scanf("%d",&t);
	while(t--)
	{
	    scanf("%d%d",&n,&x);
	    if(n<x)
	    {
	        if((x-n)<n)
	        printf("%d\n", x-n);
	        else 
	        printf("%d\n",n);
	    }
	    
	    else if(n==x)
	    printf("0\n");
	    else
	    {
	        if((n-x)<x)
	        printf("%d\n", n-x);
	        else
	        printf("%d\n",x);
	    }
	    
	}

}

